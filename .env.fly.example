# Credenciales de producción para `pnpm release` (copia este archivo a .env.fly; .env.fly no se commitea).
# Deben coincidir con lo configurado en Fly (fly secrets) y en el CMS de producción.
ADMIN_EMAIL=admin@korokotico.com
ADMIN_PASSWORD=
# Mismo valor que el secreto DIRECTUS_TOKEN de la app web
WEBSITE_TOKEN=
