# URL interna del CMS (en Fly puede ser https://admin.korokotico.com)
DIRECTUS_URL=http://localhost:8055
# Token estático del usuario "Sitio web" (mismo valor que WEBSITE_TOKEN del seed)
DIRECTUS_TOKEN=korokotico-dev-token
# Secreto para firmar la cookie del carrito
SESSION_SECRET=cambia-este-secreto
# URL pública del sitio (canonical, Open Graph y sitemap)
SITE_URL=http://localhost:5173
# Avisos de pedidos por correo (Resend). Vacío = no se envían (se avisa en la consola).
RESEND_API_KEY=
ORDER_EMAIL_FROM="Korokotico <pedidos@korokotico.com>"
