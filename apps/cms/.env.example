# Usado por `pnpm cms:seed` (crea el esquema, permisos y contenido inicial)
DIRECTUS_URL=http://localhost:8055
ADMIN_EMAIL=admin@korokotico.com
ADMIN_PASSWORD=korokotico
# Token estático del usuario "Sitio web" que usa la web para guardar solicitudes.
# Usa el mismo valor en DIRECTUS_TOKEN de apps/web/.env (en producción genera uno largo y aleatorio).
WEBSITE_TOKEN=korokotico-dev-token
