{
  "name": "korokotico",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm --filter web typecheck",
    "cms:up": "docker compose up -d cms",
    "cms:down": "docker compose down",
    "cms:seed": "pnpm --filter cms seed",
    "cms:migrate": "pnpm --filter cms seed",
    "cms:migrate:demo": "pnpm --filter cms seed -- --demo-parts",
    "deploy:cms": "cd apps/cms && fly deploy --remote-only",
    "release": "node scripts/deploy.mjs",
    "deploy:web": "fly deploy . --config apps/web/fly.toml --dockerfile apps/web/Dockerfile"
  }
}
